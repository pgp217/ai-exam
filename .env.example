# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
# 레거시 service_role 키(JWT) 또는 새 Secret key(sb_secret_...). SUPABASE_SECRET_KEY 이름도 읽는다.
# 서버 코드는 SUPABASE_URL 이 없으면 NEXT_PUBLIC_SUPABASE_URL 을 쓴다.
SUPABASE_SERVICE_ROLE_KEY=

# 저장소 강제 지정 (memory | supabase). 비우면 서버 키가 있을 때 supabase, 없으면 개발 서버에서만 memory.
EXAM_STORE=

# 서술형 AI 1차 채점 (서버 전용)
ANTHROPIC_API_KEY=
